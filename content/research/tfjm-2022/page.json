  "decisions": [
    {
      "title": "One bit per answer",
      "md": "reasoning-1.md",
      "formula": [
        "k = \\lfloor \\log_2(n!) \\rfloor + 1",
        "\\\\[6pt]",
        "n = 3:\\quad \\begin{array}{c|c} \\text{plan} & \\text{number in base 2} \\\\ \\hline 123 & 000 \\\\ 132 & 001 \\\\ 213 & 010 \\\\ 231 & 011 \\\\ 312 & 100 \\\\ 321 & 101 \\end{array}"
      ],
      "caption": "For n = 3, the 3! = 6 plans fit on 3 bits: ⌊log₂ 6⌋ + 1 = 3 questions. For n ≥ 3, n! is divisible by 3, so it is never a power of 2: hence the + 1."
    }
  ],
